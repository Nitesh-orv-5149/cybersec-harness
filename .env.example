# Copy to .env and load it into your shell before starting the service:  set -a; source .env; set +a
# Nothing reads this file automatically. Never commit a real .env.
WORKBENCH_MONGO_URI=mongodb://127.0.0.1:27017
WORKBENCH_MONGO_DB=workbench
# WORKBENCH_PORT=4318
# WORKBENCH_DATA_DIR=$HOME/.local/share/workbench
# WORKBENCH_LOG_LEVEL=info
# Optional: used by packages/orchestrator when launching it from an environment loaded with this file.
# Add a newly rotated key to your local, git-ignored .env; never commit the key.
# OPENAI_API_KEY=your-new-api-key
# OPENAI_MODEL=gpt-4o-mini
